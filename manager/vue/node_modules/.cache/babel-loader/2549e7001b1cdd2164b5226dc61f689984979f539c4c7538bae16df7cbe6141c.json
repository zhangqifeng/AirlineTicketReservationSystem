{"ast":null,"code":"export default {\n  data() {\n    return {\n      pageNum: 1,\n      pageSize: 5,\n      total: 0,\n      introductionData: [],\n      name: null\n    };\n  },\n  mounted() {\n    this.loadIntroduction(1);\n  },\n  methods: {\n    loadIntroduction(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/introduction/selectpage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSizes: this.pageSize\n        }\n      }).then(res => {\n        this.introductionData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    reset() {\n      this.name = null;\n      this.startAirport = null;\n      this.endAirport = null;\n      this.load();\n    },\n    handleCurrentChange(pageNum) {\n      this.pageNum = pageNum;\n      this.loadIntroduction(pageNum);\n    }\n  }\n};","map":{"version":3,"names":["data","pageNum","pageSize","total","introductionData","name","mounted","loadIntroduction","methods","$request","get","params","pageSizes","then","res","list","reset","startAirport","endAirport","load","handleCurrentChange"],"sources":["src/views/front/Introduction.vue"],"sourcesContent":["<template>\n  <div class=\"main-content\">\n    <div style=\"width: 70%; margin: 20px auto\">\n      <div class=\"search\">\n        <el-input placeholder=\"请输入关键字查询\" style=\"width: 200px\" v-model=\"name\"></el-input>\n        <el-button type=\"info\" plain style=\"margin-left: 10px\" @click=\"loadIntroduction(1)\">查询</el-button>\n        <el-button type=\"warning\" plain style=\"margin-left: 10px\" @click=\"reset\">重置</el-button>\n      </div>\n      <div style=\"margin-top: 30px\">\n        <el-row :gutter=\"20\" v-for=\"item in introductionData\" style=\"margin-bottom: 20px\">\n          <el-col :span=\"7\">\n            <img :src=\"item.img\" alt=\"\" stye=\"width: 100%;height: 200px; border-radius: 10px; cursor: pointer\" @click>\n          </el-col>\n          <el-col :span=\"17\">\n            <div style=\"color:#333333;font-size:18px; line-height: 30px\" class=\"overflowShow\">{{item.name}}</div>\n            <div style=\"display: flex; align-items: center; line-height: 40px; height: 40px\">\n              <img :src=\"item.userAvatar\" alt=\"\" style=\"width: 30px; height: 30px; border-radius: 50%\">\n              <div style=\"margin-left: 10px; color: #333333\">{{item.username}}</div>\n            </div>\n            <div style=\"margin-top: 10px; line-height: 30px; color: #666666\" class=\"multi-overflowShow\">{{item.description}}\n            </div>\n            <div style=\"height: 30px; line-height: 30px\">\n              <div><i class=\"el-icon-view\"></i>{{item.view}}</div>\n              <div style=\"margin: 0 30px\"><i class=\"el-icon-star-off\"></i> {{item.collect}}</div>\n              <div><i class=\"el-icon-chat-line-square\"></i>{{item.comment}}</div>\n            </div>\n          </el-col>\n        </el-row>\n      </div>\n      <div class=\"pagination\" style=\"margin-top: 20px\">\n        <el-pagination\n            background\n            @current-change=\"handleCurrentChange\"\n            :current-page=\"pageNum\"\n            :page-sizes=\"[5, 10, 20]\"\n            :page-size=\"pageSize\"\n            layout=\"total, prev, pager, next\"\n            :total=\"total\">\n        </el-pagination>\n      </div>\n    </div>\n  </div>\n</template>\n<script>\n\nexport default {\n\n  data() {\n    return {\n      pageNum: 1,\n      pageSize: 5,\n      total: 0,\n      introductionData:[],\n      name:null,\n\n    }\n  },\n  mounted() {\n    this.loadIntroduction(1)\n  },\n  methods: {\n    loadIntroduction(pageNum){\n      if(pageNum)this.pageNum = pageNum\n      this.$request.get('/introduction/selectpage',{\n        params: {\n          pageNum: this.pageNum,\n          pageSizes: this.pageSize,\n        }\n      }).then(res => {\n            this.introductionData = res.data?.list\n            this.total = res.data?.total\n          }\n      )\n    },\n    reset() {\n      this.name = null\n      this.startAirport = null\n      this.endAirport = null\n      this.load()\n    },\n    handleCurrentChange(pageNum){\n      this.pageNum = pageNum\n      this.loadIntroduction(pageNum)\n    }\n  }\n}\n</script>\n<style>\n.overflowShow{\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.multi-overflowShow {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 3;\n}\n</style>"],"mappings":"AA6CA;EAEAA,KAAA;IACA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;MACAC,gBAAA;MACAC,IAAA;IAEA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACAD,iBAAAN,OAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAQ,QAAA,CAAAC,GAAA;QACAC,MAAA;UACAV,OAAA,OAAAA,OAAA;UACAW,SAAA,OAAAV;QACA;MACA,GAAAW,IAAA,CAAAC,GAAA;QACA,KAAAV,gBAAA,GAAAU,GAAA,CAAAd,IAAA,EAAAe,IAAA;QACA,KAAAZ,KAAA,GAAAW,GAAA,CAAAd,IAAA,EAAAG,KAAA;MACA,CACA;IACA;IACAa,MAAA;MACA,KAAAX,IAAA;MACA,KAAAY,YAAA;MACA,KAAAC,UAAA;MACA,KAAAC,IAAA;IACA;IACAC,oBAAAnB,OAAA;MACA,KAAAA,OAAA,GAAAA,OAAA;MACA,KAAAM,gBAAA,CAAAN,OAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}