{"ast":null,"code":"import E from 'wangeditor';\nimport { Transition } from 'vue';\nexport default {\n  name: 'Home',\n  computed: {\n    form() {\n      return form;\n    }\n  },\n  data() {\n    return {\n      introductionData: [],\n      pageNum: 1,\n      pageSize: 5,\n      total: 0\n    };\n  },\n  mounted() {\n    this.loadIntroduction(1);\n  },\n  methods: {\n    loadIntroduction(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/introduction/selectpage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSizes: this.pageSize\n        }\n      }).then(res => {\n        this.introductionData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    }\n  }\n};","map":{"version":3,"names":["E","Transition","name","computed","form","data","introductionData","pageNum","pageSize","total","mounted","loadIntroduction","methods","$request","get","params","pageSizes","then","res","list"],"sources":["src/views/front/Introduction.vue"],"sourcesContent":["<template>\n  <div>\n  <div class=\"main-content\">\n    <div style=\"width: 70%; margin: 20px auto\">\n      <div class=\"search\">\n        <el-input placeholder=\"请输入关键字查询\" style=\"width: 200px\" v-model=\"name\"></el-input>\n        <el-button type=\"info\" plain style=\"margin-left: 10px\" @click=\"loadIntroduction(1)\">查询</el-button>\n        <el-button type=\"warning\" plain style=\"margin-left: 10px\" @click=\"reset\">重置</el-button>\n      </div>\n    </div>\n\n    <div style=\"margin-top: 30px\">\n    <el-row :gutter=\"20\" v-for=\"item in introductionData\" style=\"margin-bottom: 20px\">\n      <el-col :span=\"7\">\n        <img :src=\"item.img\" alt=\"\" stye=\"width: 100%;height: 200px; border-radius: 10px\">\n        </el-col>\n        <el-col :span=\"17\">\n          <div style=\"color:#333333;font-size:18px; line-height: 30px\" class=\"overflowShow\">{{item.name}}</div>\n          <div style=\"display: flex; align-items: center; line-height: 40px; height: 40px\">\n            <img :src=\"item.userAvatar\" alt=\"\" style=\"width: 30px; height: 30px; border-radius: 50%\">\n            <div style=\"margin-left: 10px; color: #333333\">{{item.username}}</div>\n          </div>\n            <div style=\"margin-top: 10px; line-height: 30px; color: #666666\" class=\"multi-overflowShow\">{{item.description}}\n            </div>\n          <div style=\"height: 30px; line-height: 30px\">\n            <div><i class=\"el-icon-view\"></i>{{introductionData.view}}</div>\n            <div style=\"margin: 0 30px\"><i class=\"el-icon-star-off\"></i> {{introductionData.collect}}</div>\n            <div><i class=\"el-icon-chat-line-square\"></i>{{introductionData.comment}}</div>\n          </div>\n            </el-col>\n      </el-row>\n    </div>\n  </div>\n  </div>\n</template>\n<script>\nimport E from 'wangeditor';\nimport { Transition } from 'vue'\n\n\n\nexport default {\n  name: 'Home',\n  computed: {\n    form() {\n      return form\n    }\n  },\n  data() {\n    return {\n      introductionData:[],\n      pageNum: 1,\n      pageSize: 5,\n      total: 0,\n\n    }\n  },\n  mounted() {\n    this.loadIntroduction(1)\n  },\n  methods: {\n    loadIntroduction(pageNum){\n      if(pageNum)this.pageNum = pageNum\n      this.$request.get('/introduction/selectpage',{\n        params: {\n          pageNum: this.pageNum,\n          pageSizes: this.pageSize,\n        }\n      }).then(res => {\n            this.introductionData = res.data?.list\n            this.total = res.data?.total\n          }\n      )\n    },\n  }\n}\n</script>\n<style>\n.overflowShow{\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.multi-overflowShow {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 3;\n}\n</style>"],"mappings":"AAoCA,OAAAA,CAAA;AACA,SAAAC,UAAA;AAIA;EACAC,IAAA;EACAC,QAAA;IACAC,KAAA;MACA,OAAAA,IAAA;IACA;EACA;EACAC,KAAA;IACA;MACAC