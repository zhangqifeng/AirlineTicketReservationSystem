{"ast":null,"code":"import E from 'wangeditor';\nimport { Transition } from 'vue';\nexport default {\n  name: 'Home',\n  computed: {\n    form() {\n      return form;\n    }\n  },\n  data() {\n    return {\n      introductionData: [],\n      pageNum: 1,\n      pageSize: 5,\n      total: 0\n    };\n  },\n  mounted() {\n    this.loadIntroduction(1);\n  },\n  methods: {\n    loadIntroduction(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/introduction/selectpage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSizes: this.pageSize\n        }\n      }).then(res => {\n        this.introductionData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    initWangEditor(content) {\n      this.$nextTick(() => {\n        this.editor = new E('#editor');\n        this.editor.config.placeholder = '请输入内容';\n        this.editor.config.uploadFileName = 'file';\n        this.editor.config.uploadImgServer = 'http://localhost:9090/files/wang/upload';\n        this.editor.create();\n        setTimeout(() => {\n          this.editor.txt.html(content);\n        });\n      });\n    },\n    save() {\n      // 保存按钮触发的逻辑  它会触发新增或者更新\n      this.$refs.formRef.validate(valid => {\n        if (valid) {\n          this.$request({\n            url: this.form.id ? '/introduction/update' : '/introduction/add',\n            method: this.form.id ? 'PUT' : 'POST',\n            data: this.form\n          }).then(res => {\n            if (res.code === '200') {\n              // 表示成功保存\n              this.$message.success('保存成功');\n              // this.load(1)\n              this.fromVisible = false;\n            } else {\n              this.$message.error(res.msg); // 弹出错误的信息\n            }\n          });\n        }\n      });\n    },\n\n    handleAdd() {\n      this.form = {};\n      this.initWangEditor('');\n      this.fromVisible = true;\n    },\n    handleImgSuccess(res) {\n      this.form.img = res.data;\n    }\n  },\n  created() {\n    this.$request.get('/notice/selectAll').then(res => {\n      this.notices = res.data || [];\n    });\n  }\n};","map":{"version":3,"names":["E","Transition","name","computed","form","data","introductionData","pageNum","pageSize","total","mounted","loadIntroduction","methods","$request","get","params","pageSizes","then","res","list","initWangEditor","content","$nextTick","editor","config","placeholder","uploadFileName","uploadImgServer","create","setTimeout","txt","html","save","$refs","formRef","validate","valid","url","id","method","code","$message","success","fromVisible","error","msg","handleAdd","handleImgSuccess","img","created","notices"],"sources":["src/views/front/Introduction.vue"],"sourcesContent":["<template>\n  <div>\n  <div class=\"main-content\">\n    <div style=\"width: 70%; margin: 20px auto\">\n      <div class=\"search\">\n        <el-input placeholder=\"请输入关键字查询\" style=\"width: 200px\" v-model=\"name\"></el-input>\n        <el-button type=\"info\" plain style=\"margin-left: 10px\" @click=\"loadIntroduction(1)\">查询</el-button>\n        <el-button type=\"warning\" plain style=\"margin-left: 10px\" @click=\"reset\">重置</el-button>\n      </div>\n    </div>\n\n    <div class=\"table\">\n      <el-table :data=\"tableData\" stripe @selection-change=\"handleSelectionChange\">\n        <el-table-column type=\"selection\" width=\"55\" align=\"center\"></el-table-column>\n        <el-table-column prop=\"id\" label=\"序号\" width=\"80\" align=\"center\" sortable></el-table-column>\n        <el-table-column prop=\"name\" label=\"名称\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"img\" label=\"图片\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"content\" label=\"内容\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"collect\" label=\"收藏数\"></el-table-column>\n        <el-table-column prop=\"views\" label=\"浏览量\"></el-table-column>\n        <el-table-column prop=\"time\" label=\"发布时间\"></el-table-column>\n        <el-table-column  label=\"操作\" width=\"180\" align=\"center\">\n          <template v-slot=\"scope\">\n            <el-button plain type=\"primary\" @click=\"handleEdit(scope.row)\" size=\"mini\">编辑</el-button>\n            <el-button plain type=\"danger\" size=\"mini\" @click=del(scope.row.id)>删除</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <div class=\"pagination\" style=\"margin-top: 20px\">\n        <el-pagination\n            background\n            @current-change=\"handleCurrentChange\"\n            :current-page=\"pageNum\"\n            :page-sizes=\"[5, 10, 20]\"\n            :page-size=\"pageSize\"\n            layout=\"total, prev, pager, next\"\n            :total=\"total\">\n        </el-pagination>\n      </div>\n    </div>\n  </div>\n  <el-dialog title=\"信息\" :visible.sync=\"fromVisible\" width=\"40%\" :close-on-click-modal=\"false\" destroy-on-close>\n    <el-form label-width=\"100px\" style=\"padding-right: 50px\" :model=\"form\">\n      <el-form-item label=\"攻略主图\">\n        <el-upload\n            class=\"avatar-uploader\"\n            :action=\"$baseUrl + '/files/upload'\"\n            :headers=\"{ token: user.token }\"\n            list-type=\"picture\"\n            :on-success=\"handleImgSuccess\">\n          <el-button type=\"primary\">上传攻略主图</el-button>\n        </el-upload>\n      </el-form-item>\n      <el-form-item label=\"攻略标题\" prop=\"name\">\n        <el-input v-model=\"form.name\" autocomplete=\"off\"></el-input>\n      </el-form-item>\n      <el-form-item label=\"攻略详情\" prop=\"content\">\n       <div id=\"editor\"></div>\n      </el-form-item>\n    </el-form>\n\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"fromVisible = false\">取 消</el-button>\n      <el-button type=\"primary\" @click=\"save\">确 定</el-button>\n    </div>\n  </el-dialog>\n  </div>\n</template>\n<script>\nimport E from 'wangeditor';\nimport { Transition } from 'vue'\n\n\n\nexport default {\n  name: 'Home',\n  computed: {\n    form() {\n      return form\n    }\n  },\n  data() {\n    return {\n      introductionData:[],\n      pageNum: 1,\n      pageSize: 5,\n      total: 0,\n\n    }\n  },\n  mounted() {\n    this.loadIntroduction(1)\n  },\n  methods: {\n    loadIntroduction(pageNum){\n      if(pageNum)this.pageNum = pageNum\n      this.$request.get('/introduction/selectpage',{\n        params: {\n          pageNum: this.pageNum,\n          pageSizes: this.pageSize,\n        }\n      }).then(res => {\n            this.introductionData = res.data?.list\n            this.total = res.data?.total\n          }\n      )\n    },\n    initWangEditor(content) {\n      this.$nextTick(() => {\n        this.editor = new E('#editor')\n        this.editor.config.placeholder = '请输入内容'\n        this.editor.config.uploadFileName = 'file'\n        this.editor.config.uploadImgServer = 'http://localhost:9090/files/wang/upload'\n        this.editor.create()\n        setTimeout(() => {\n          this.editor.txt.html(content)\n        })\n      })\n    },\n    save() {   // 保存按钮触发的逻辑  它会触发新增或者更新\n      this.$refs.formRef.validate((valid) => {\n        if (valid) {\n          this.$request({\n            url: this.form.id ? '/introduction/update' : '/introduction/add',\n            method: this.form.id ? 'PUT' : 'POST',\n            data: this.form\n          }).then(res => {\n            if (res.code === '200') {  // 表示成功保存\n              this.$message.success('保存成功')\n              // this.load(1)\n              this.fromVisible = false\n            } else {\n              this.$message.error(res.msg)  // 弹出错误的信息\n            }\n          })\n        }\n      })\n    },\n    handleAdd(){\n      this.form = {}\n      this.initWangEditor('')\n      this.fromVisible = true\n    },\n    handleImgSuccess(res){\n      this.form.img = res.data\n    }\n  },\n  created() {\n    this.$request.get('/notice/selectAll').then(res => {\n      this.notices = res.data || []\n    })\n  }\n}\n</script>\n<style>\n.overflowShow{\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.\n</style>"],"mappings":"AAsEA,OAAAA,CAAA;AACA,SAAAC,UAAA;AAIA;EACAC,IAAA;EACAC,QAAA;IACAC,KAAA;MACA,OAAAA,IAAA;IACA;EACA;EACAC,KAAA;IACA;MACAC,gBAAA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;IAEA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACAD,iBAAAJ,OAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAM,QAAA,CAAAC,GAAA;QACAC,MAAA;UACAR,OAAA,OAAAA,OAAA;UACAS,SAAA,OAAAR;QACA;MACA,GAAAS,IAAA,CAAAC,GAAA;QACA,KAAAZ,gBAAA,GAAAY,GAAA,CAAAb,IAAA,EAAAc,IAAA;QACA,KAAAV,KAAA,GAAAS,GAAA,CAAAb,IAAA,EAAAI,KAAA;MACA,CACA;IACA;IACAW,eAAAC,OAAA;MACA,KAAAC,SAAA;QACA,KAAAC,MAAA,OAAAvB,CAAA;QACA,KAAAuB,MAAA,CAAAC,MAAA,CAAAC,WAAA;QACA,KAAAF,MAAA,CAAAC,MAAA,CAAAE,cAAA;QACA,KAAAH,MAAA,CAAAC,MAAA,CAAAG,eAAA;QACA,KAAAJ,MAAA,CAAAK,MAAA;QACAC,UAAA;UACA,KAAAN,MAAA,CAAAO,GAAA,CAAAC,IAAA,CAAAV,OAAA;QACA;MACA;IACA;IACAW,KAAA;MAAA;MACA,KAAAC,KAAA,CAAAC,OAAA,CAAAC,QAAA,CAAAC,KAAA;QACA,IAAAA,KAAA;UACA,KAAAvB,QAAA;YACAwB,GAAA,OAAAjC,IAAA,CAAAkC,EAAA;YACAC,MAAA,OAAAnC,IAAA,CAAAkC,EAAA;YACAjC,IAAA,OAAAD;UACA,GAAAa,IAAA,CAAAC,GAAA;YACA,IAAAA,GAAA,CAAAsB,IAAA;cAAA;cACA,KAAAC,QAAA,CAAAC,OAAA;cACA;cACA,KAAAC,WAAA;YACA;cACA,KAAAF,QAAA,CAAAG,KAAA,CAAA1B,GAAA,CAAA2B,GAAA;YACA;UACA;QACA;MACA;IACA;;IACAC,UAAA;MACA,KAAA1C,IAAA;MACA,KAAAgB,cAAA;MACA,KAAAuB,WAAA;IACA;IACAI,iBAAA7B,GAAA;MACA,KAAAd,IAAA,CAAA4C,GAAA,GAAA9B,GAAA,CAAAb,IAAA;IACA;EACA;EACA4C,QAAA;IACA,KAAApC,QAAA,CAAAC,GAAA,sBAAAG,IAAA,CAAAC,GAAA;MACA,KAAAgC,OAAA,GAAAhC,GAAA,CAAAb,IAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}