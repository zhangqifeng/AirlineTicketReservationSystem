{"ast":null,"code":"export default {\n  data() {\n    return {\n      pageNum: 1,\n      pageSize: 5,\n      total: 0,\n      collectData: [],\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}')\n    };\n  },\n  mounted() {\n    this.loadIntroduction(1);\n  },\n  methods: {\n    loadIntroduction(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/collect/selectpage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSizes: this.pageSize,\n          userId: this.user.id\n        }\n      }).then(res => {\n        this.collectData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    reset() {\n      this.name = null;\n      this.startAirport = null;\n      this.endAirport = null;\n      this.load();\n    },\n    handleCurrentChange(pageNum) {\n      this.pageNum = pageNum;\n      this.loadIntroduction(pageNum);\n    }\n  }\n};","map":{"version":3,"names":["data","pageNum","pageSize","total","collectData","user","JSON","parse","localStorage","getItem","mounted","loadIntroduction","methods","$request","get","params","pageSizes","userId","id","then","res","list","reset","name","startAirport","endAirport","load","handleCurrentChange"],"sources":["src/views/front/MyCollect.vue"],"sourcesContent":["<template>\n  <div class=\"main-content\">\n    <div style=\"width: 70%; margin: 20px auto\">\n      <div class=\"search\">\n        我收藏的攻略（}{collectData.length}}）\n      </div>\n      <div style=\"margin-top: 30px\">\n        <el-row :gutter=\"20\" v-for=\"item in collectData\" style=\"margin-bottom: 20px\">\n          <el-col :span=\"7\">\n            <img :src=\"item.img\" alt=\"\" stye=\"width: 100%;height: 200px; border-radius: 10px; cursor: pointer\" @click=\"$router.push('/front/introDetail?id=' + item.introductionId )\">\n          </el-col>\n          <el-col :span=\"17\">\n            <div style=\"color:#333333;font-size:18px; line-height: 30px\" class=\"overflowShow\">{{item.introName}}</div>\n            <div style=\"display: flex; align-items: center; line-height: 40px; height: 40px\">\n              <img :src=\"item.userAvatar\" alt=\"\" style=\"width: 30px; height: 30px; border-radius: 50%\">\n              <div style=\"margin-left: 10px; color: #333333\">{{item.username}}</div>\n            </div>\n            <div style=\"margin-top: 10px; line-height: 30px; color: #666666\" class=\"multi-overflowShow\">{{item.description}}\n            </div>\n            <div style=\"height: 30px; line-height: 30px\">\n              <div><i class=\"el-icon-view\"></i>{{item.view}}</div>\n              <div style=\"margin: 0 30px\"><i class=\"el-icon-star-off\"></i> {{item.collect}}</div>\n              <div><i class=\"el-icon-chat-line-square\"></i>{{item.comment}}</div>\n              <div style=\"margin-left: 30px\"><i class=\"el-icon-delete\"></i></div>\n            </div>\n          </el-col>\n        </el-row>\n      </div>\n      <div class=\"pagination\" style=\"margin-top: 20px\">\n        <el-pagination\n            background\n            @current-change=\"handleCurrentChange\"\n            :current-page=\"pageNum\"\n            :page-sizes=\"[5, 10, 20]\"\n            :page-size=\"pageSize\"\n            layout=\"total, prev, pager, next\"\n            :total=\"total\">\n        </el-pagination>\n      </div>\n    </div>\n  </div>\n</template>\n<script>\n\nexport default {\n\n  data() {\n    return {\n      pageNum: 1,\n      pageSize: 5,\n      total: 0,\n      collectData:[],\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n\n\n    }\n  },\n  mounted() {\n    this.loadIntroduction(1)\n  },\n  methods: {\n    loadIntroduction(pageNum){\n      if(pageNum)this.pageNum = pageNum\n      this.$request.get('/collect/selectpage',{\n        params: {\n          pageNum: this.pageNum,\n          pageSizes: this.pageSize,\n          userId: this.user.id,\n\n        }\n      }).then(res => {\n            this.collectData = res.data?.list\n            this.total = res.data?.total\n          }\n      )\n    },\n    reset() {\n      this.name = null\n      this.startAirport = null\n      this.endAirport = null\n      this.load()\n    },\n    handleCurrentChange(pageNum){\n      this.pageNum = pageNum\n      this.loadIntroduction(pageNum)\n    }\n  }\n}\n</script>\n<style>\n.overflowShow{\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.multi-overflowShow {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 3;\n}\n</style>"],"mappings":"AA4CA;EAEAA,KAAA;IACA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;MACAC,WAAA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IAGA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACAD,iBAAAV,OAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAY,QAAA,CAAAC,GAAA;QACAC,MAAA;UACAd,OAAA,OAAAA,OAAA;UACAe,SAAA,OAAAd,QAAA;UACAe,MAAA,OAAAZ,IAAA,CAAAa;QAEA;MACA,GAAAC,IAAA,CAAAC,GAAA;QACA,KAAAhB,WAAA,GAAAgB,GAAA,CAAApB,IAAA,EAAAqB,IAAA;QACA,KAAAlB,KAAA,GAAAiB,GAAA,CAAApB,IAAA,EAAAG,KAAA;MACA,CACA;IACA;IACAmB,MAAA;MACA,KAAAC,IAAA;MACA,KAAAC,YAAA;MACA,KAAAC,UAAA;MACA,KAAAC,IAAA;IACA;IACAC,oBAAA1B,OAAA;MACA,KAAAA,OAAA,GAAAA,OAAA;MACA,KAAAU,gBAAA,CAAAV,OAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}