{"ast":null,"code":"import E from 'wangeditor';\nexport default {\n  data() {\n    return {\n      introductionId: this.$route.query.id,\n      introductionData: {}\n    };\n  },\n  mounted() {\n    this.loadIntroduction();\n    this.addViews();\n  },\n  // methods：本页面所有的点击事件或者其他函数定义区\n  methods: {\n    loadIntroduction() {\n      this.request('/introduction/selectById/' + this.introductionId).then(res => {\n        if (res.code === '200') {\n          this.introductionData = res.data;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    addViews() {\n      let introduction;\n      this.request.put('/introduction/update');\n    }\n  }\n};","map":{"version":3,"names":["E","data","introductionId","$route","query","id","introductionData","mounted","loadIntroduction","addViews","methods","request","then","res","code","$message","error","msg","introduction","put"],"sources":["src/views/front/IntroDetail.vue"],"sourcesContent":["<template xmlns:display=\"http://www.w3.org/1999/xhtml\">\r\n  <div class=\"main-content\">\r\n    <div style=\"width: 90%; margin: 20px auto\">\r\n      <div style=\"front-size: 18px; font-weight: bold; color:#333333\">{{introductionData.name}}}</div>\r\n        <div style=\"margin-top: 20px; display: flex; color:#666666; align-items: center;\">\r\n          <div style=\"margin-right: 30px\">作者：{{introductionData.userName}}</div>\r\n          <div><i class=\"el-icon-view\"></i>{{introductionData.view}}</div>\r\n          <div style=\"margin: 0 30px\"><i class=\"el-icon-star-off\"></i> {{introductionData.collect}}</div>\r\n          <div><i class=\"el-icon-chat-line-square\"></i>{{introductionData.comment}}</div>\r\n      <div style=\"margin-left: 30px\"><el-button size=\"mini\" type=\"primary\">收藏</el-button></div>\r\n        </div>\r\n      <div style=\"margin-top: 30px\" v-html = introductionData.content class=\"w-e-text-container\"></div>\r\n      </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport E from 'wangeditor'\r\n\r\nexport default {\r\n\r\n  data() {\r\n    return {\r\n      introductionId: this.$route.query.id,\r\n      introductionData:{}\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadIntroduction()\r\n    this.addViews()\r\n  },\r\n  // methods：本页面所有的点击事件或者其他函数定义区\r\n  methods: {\r\n    loadIntroduction(){\r\n        this.request('/introduction/selectById/' + this.introductionId).then(res => {\r\n          if (res.code === '200'){\r\n            this.introductionData = res.data\r\n          } else {\r\n            this.$message.error(res.msg)\r\n          }\r\n        })\r\n    },\r\n    addViews(){\r\n      let introduction\r\n      this.request.put('/introduction/update')\r\n    }\r\n  }\r\n}\r\n</script>\r\n<style>\r\n.overflowShow {\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\np,ol{\r\n  color: #666666;\r\n}\r\n</style>"],"mappings":"AAiBA,OAAAA,CAAA;AAEA;EAEAC,KAAA;IACA;MACAC,cAAA,OAAAC,MAAA,CAAAC,KAAA,CAAAC,EAAA;MACAC,gBAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;IACA,KAAAC,QAAA;EACA;EACA;EACAC,OAAA;IACAF,iBAAA;MACA,KAAAG,OAAA,oCAAAT,cAAA,EAAAU,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAR,gBAAA,GAAAO,GAAA,CAAAZ,IAAA;QACA;UACA,KAAAc,QAAA,CAAAC,KAAA,CAAAH,GAAA,CAAAI,GAAA;QACA;MACA;IACA;IACAR,SAAA;MACA,IAAAS,YAAA;MACA,KAAAP,OAAA,CAAAQ,GAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}