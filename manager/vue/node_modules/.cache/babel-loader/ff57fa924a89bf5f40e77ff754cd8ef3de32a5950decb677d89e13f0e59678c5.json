{"ast":null,"code":"import E from 'wangeditor';\nexport default {\n  data() {\n    return {\n      introductionId: this.$route.query.id,\n      introductionData: {}\n    };\n  },\n  mounted() {\n    this.loadIntroduction();\n  },\n  // methods：本页面所有的点击事件或者其他函数定义区\n  methods: {\n    loadIntroduction() {\n      this.request('/introduction/selectById/' + this.introductionId).then(res => {\n        if (res.code === '200') {\n          this.introductionData = res.data;\n          this.addViews();\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    addViews() {\n      this.introductionData.views = this.introductionData.views + 1;\n      this.request.put('/introduction/update', this.introductionData).then(res => {\n        if (res.code !== '200') {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    collect() {\n      let data = {};\n      this.$request.post('/collect/add');\n    }\n  }\n};","map":{"version":3,"names":["E","data","introductionId","$route","query","id","introductionData","mounted","loadIntroduction","methods","request","then","res","code","addViews","$message","error","msg","views","put","collect","$request","post"],"sources":["src/views/front/IntroDetail.vue"],"sourcesContent":["<template xmlns:display=\"http://www.w3.org/1999/xhtml\">\r\n  <div class=\"main-content\">\r\n    <div style=\"width: 90%; margin: 20px auto\">\r\n      <div style=\"front-size: 18px; font-weight: bold; color:#333333\">{{introductionData.name}}}</div>\r\n        <div style=\"margin-top: 20px; display: flex; color:#666666; align-items: center;\">\r\n          <div style=\"margin-right: 30px\">作者：{{introductionData.userName}}</div>\r\n          <div><i class=\"el-icon-view\"></i>{{introductionData.view}}</div>\r\n          <div style=\"margin: 0 30px\"><i class=\"el-icon-star-off\"></i> {{introductionData.collect}}</div>\r\n          <div><i class=\"el-icon-chat-line-square\"></i>{{introductionData.comment}}</div>\r\n      <div style=\"margin-left: 30px\"><el-button size=\"mini\" type=\"primary\">收藏</el-button></div>\r\n        </div>\r\n      <div style=\"margin-top: 30px\" v-html = introductionData.content class=\"w-e-text-container\"></div>\r\n      </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport E from 'wangeditor'\r\n\r\nexport default {\r\n\r\n  data() {\r\n    return {\r\n      introductionId: this.$route.query.id,\r\n      introductionData:{}\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadIntroduction()\r\n\r\n  },\r\n  // methods：本页面所有的点击事件或者其他函数定义区\r\n  methods: {\r\n    loadIntroduction(){\r\n        this.request('/introduction/selectById/' + this.introductionId).then(res => {\r\n          if (res.code === '200'){\r\n            this.introductionData = res.data\r\n            this.addViews()\r\n          } else {\r\n            this.$message.error(res.msg)\r\n          }\r\n        })\r\n    },\r\n    addViews(){\r\n      this.introductionData.views = this.introductionData.views + 1\r\n      this.request.put('/introduction/update', this.introductionData).then(res => {\r\n        if(res.code !== '200'){\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    collect(){\r\n      let data = {}\r\n      this.$request.post('/collect/add')\r\n    }\r\n  }\r\n}\r\n</script>\r\n<style>\r\n.overflowShow {\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\np,ol{\r\n  color: #666666;\r\n}\r\n</style>"],"mappings":"AAiBA,OAAAA,CAAA;AAEA;EAEAC,KAAA;IACA;MACAC,cAAA,OAAAC,MAAA,CAAAC,KAAA,CAAAC,EAAA;MACAC,gBAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EAEA;EACA;EACAC,OAAA;IACAD,iBAAA;MACA,KAAAE,OAAA,oCAAAR,cAAA,EAAAS,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAP,gBAAA,GAAAM,GAAA,CAAAX,IAAA;UACA,KAAAa,QAAA;QACA;UACA,KAAAC,QAAA,CAAAC,KAAA,CAAAJ,GAAA,CAAAK,GAAA;QACA;MACA;IACA;IACAH,SAAA;MACA,KAAAR,gBAAA,CAAAY,KAAA,QAAAZ,gBAAA,CAAAY,KAAA;MACA,KAAAR,OAAA,CAAAS,GAAA,8BAAAb,gBAAA,EAAAK,IAAA,CAAAC,GAAA;QACA,I