{"ast":null,"code":"import E from 'wangeditor';\nimport { Transition } from 'vue';\nexport default {\n  name: 'Home',\n  computed: {\n    form() {\n      return form;\n    }\n  },\n  data() {\n    return {\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      fromVisible: false,\n      form: {},\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      editor: null\n    };\n  },\n  mounted() {\n    this.load(1);\n  },\n  methods: {\n    load(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/introduction/selectpage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSizes: this.pageSize,\n          userId: this.user.id\n        }\n      }).then(res => {\n        this.tableData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    initWangEditor(content) {\n      this.$nextTick(() => {\n        this.editor = new E('#editor');\n        this.editor.config.placeholder = '请输入内容';\n        this.editor.config.uploadFileName = 'file';\n        this.editor.config.uploadImgServer = 'http://localhost:9090/files/wang/upload';\n        this.editor.create();\n        setTimeout(() => {\n          this.editor.txt.html(content);\n        });\n      });\n    },\n    save() {\n      // 保存按钮触发的逻辑  它会触发新增或者更新\n      this.$refs.formRef.validate(valid => {\n        if (valid) {\n          this.$request({\n            url: this.form.id ? '/introduction/update' : '/introduction/add',\n            method: this.form.id ? 'PUT' : 'POST',\n            data: this.form\n          }).then(res => {\n            if (res.code === '200') {\n              // 表示成功保存\n              this.$message.success('保存成功');\n              // this.load(1)\n              this.fromVisible = false;\n            } else {\n              this.$message.error(res.msg); // 弹出错误的信息\n            }\n          });\n        }\n      });\n    },\n\n    handleAdd() {\n      this.form = {};\n      this.initWangEditor('');\n      this.fromVisible = true;\n    },\n    handleImgSuccess(res) {\n      this.form.img = res.data;\n    }\n  },\n  created() {\n    this.$request.get('/notice/selectAll').then(res => {\n      this.notices = res.data || [];\n    });\n  }\n};","map":{"version":3,"names":["E","Transition","name","computed","form","data","tableData","pageNum","pageSize","total","fromVisible","user","JSON","parse","localStorage","getItem","editor","mounted","load","methods","$request","get","params","pageSizes","userId","id","then","res","list","initWangEditor","content","$nextTick","config","placeholder","uploadFileName","uploadImgServer","create","setTimeout","txt","html","save","$refs","formRef","validate","valid","url","method","code","$message","success","error","msg","handleAdd","handleImgSuccess","img","created","notices"],"sources":["src/views/front/MyIntroduction.vue"],"sourcesContent":["<template>\n  <div>\n  <div class=\"main-content\">\n    <div style=\"width: 90%; margin: 20px auto\">\n      <div class=\"operation\">\n        <el-button type=\"primary\" plain @click=\"handleAdd\">发布素材</el-button>\n      </div>\n    </div>\n\n    <div class=\"table\">\n      <el-table :data=\"tableData\" stripe @selection-change=\"handleSelectionChange\">\n        <el-table-column type=\"selection\" width=\"55\" align=\"center\"></el-table-column>\n        <el-table-column prop=\"id\" label=\"序号\" width=\"80\" align=\"center\" sortable></el-table-column>\n        <el-table-column prop=\"name\" label=\"名称\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"img\" label=\"图片\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"content\" label=\"内容\" show-overflow-tooltip></el-table-column>\n        <el-table-column prop=\"collect\" label=\"收藏数\"></el-table-column>\n        <el-table-column prop=\"views\" label=\"浏览量\"></el-table-column>\n        <el-table-column prop=\"time\" label=\"发布时间\"></el-table-column>\n        <el-table-column  label=\"操作\" width=\"180\" align=\"center\">\n          <template v-slot=\"scope\">\n            <el-button plain type=\"primary\" @click=\"handleEdit(scope.row)\" size=\"mini\">编辑</el-button>\n            <el-button plain type=\"danger\" size=\"mini\" @click=del(scope.row.id)>删除</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <div class=\"pagination\" style=\"margin-top: 20px\">\n        <el-pagination\n            background\n            @current-change=\"handleCurrentChange\"\n            :current-page=\"pageNum\"\n            :page-sizes=\"[5, 10, 20]\"\n            :page-size=\"pageSize\"\n            layout=\"total, prev, pager, next\"\n            :total=\"total\">\n        </el-pagination>\n      </div>\n    </div>\n  </div>\n  <el-dialog title=\"信息\" :visible.sync=\"fromVisible\" width=\"40%\" :close-on-click-modal=\"false\" destroy-on-close>\n    <el-form label-width=\"100px\" style=\"padding-right: 50px\" :model=\"form\">\n      <el-form-item label=\"攻略主图\">\n        <el-upload\n            class=\"avatar-uploader\"\n            :action=\"$baseUrl + '/files/upload'\"\n            :headers=\"{ token: user.token }\"\n            list-type=\"picture\"\n            :on-success=\"handleImgSuccess\">\n          <el-button type=\"primary\">上传攻略主图</el-button>\n        </el-upload>\n      </el-form-item>\n      <el-form-item label=\"攻略标题\" prop=\"name\">\n        <el-input v-model=\"form.name\" autocomplete=\"off\"></el-input>\n      </el-form-item>\n      <el-form-item label=\"攻略详情\" prop=\"content\">\n       <div id=\"editor\"></div>\n      </el-form-item>\n    </el-form>\n\n    <div slot=\"footer\" class=\"dialog-footer\">\n      <el-button @click=\"fromVisible = false\">取 消</el-button>\n      <el-button type=\"primary\" @click=\"save\">确 定</el-button>\n    </div>\n  </el-dialog>\n  </div>\n</template>\n<script>\nimport E from 'wangeditor';\nimport { Transition } from 'vue'\n\n\n\nexport default {\n  name: 'Home',\n  computed: {\n    form() {\n      return form\n    }\n  },\n  data() {\n    return {\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      fromVisible: false,\n      form: {},\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      editor: null,\n    }\n  },\n  mounted() {\n    this.load(1)\n  },\n  methods: {\n    load(pageNum){\n      if(pageNum)this.pageNum = pageNum\n      this.$request.get('/introduction/selectpage',{\n        params: {\n          pageNum: this.pageNum,\n          pageSizes: this.pageSize,\n          userId: this.user.id,\n        }\n      }).then(res => {\n        this.tableData = res.data?.list\n        this.total = res.data?.total\n          }\n      )\n    },\n    initWangEditor(content) {\n      this.$nextTick(() => {\n        this.editor = new E('#editor')\n        this.editor.config.placeholder = '请输入内容'\n        this.editor.config.uploadFileName = 'file'\n        this.editor.config.uploadImgServer = 'http://localhost:9090/files/wang/upload'\n        this.editor.create()\n        setTimeout(() => {\n          this.editor.txt.html(content)\n        })\n      })\n    },\n    save() {   // 保存按钮触发的逻辑  它会触发新增或者更新\n      this.$refs.formRef.validate((valid) => {\n        if (valid) {\n          this.$request({\n            url: this.form.id ? '/introduction/update' : '/introduction/add',\n            method: this.form.id ? 'PUT' : 'POST',\n            data: this.form\n          }).then(res => {\n            if (res.code === '200') {  // 表示成功保存\n              this.$message.success('保存成功')\n              // this.load(1)\n              this.fromVisible = false\n            } else {\n              this.$message.error(res.msg)  // 弹出错误的信息\n            }\n          })\n        }\n      })\n    },\n    handleAdd(){\n      this.form = {}\n      this.initWangEditor('')\n      this.fromVisible = true\n    },\n    handleImgSuccess(res){\n      this.form.img = res.data\n    }\n  },\n  created() {\n    this.$request.get('/notice/selectAll').then(res => {\n      this.notices = res.data || []\n    })\n  }\n}\n</script>\n"],"mappings":"AAoEA,OAAAA,CAAA;AACA,SAAAC,UAAA;AAIA;EACAC,IAAA;EACAC,QAAA;IACAC,KAAA;MACA,OAAAA,IAAA;IACA;EACA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;MACAC,WAAA;MACAN,IAAA;MACAO,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,MAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,KAAAX,OAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAa,QAAA,CAAAC,GAAA;QACAC,MAAA;UACAf,OAAA,OAAAA,OAAA;UACAgB,SAAA,OAAAf,QAAA;UACAgB,MAAA,OAAAb,IAAA,CAAAc;QACA;MACA,GAAAC,IAAA,CAAAC,GAAA;QACA,KAAArB,SAAA,GAAAqB,GAAA,CAAAtB,IAAA,EAAAuB,IAAA;QACA,KAAAnB,KAAA,GAAAkB,GAAA,CAAAtB,IAAA,EAAAI,KAAA;MACA,CACA;IACA;IACAoB,eAAAC,OAAA;MACA,KAAAC,SAAA;QACA,KAAAf,MAAA,OAAAhB,CAAA;QACA,KAAAgB,MAAA,CAAAgB,MAAA,CAAAC,WAAA;QACA,KAAAjB,MAAA,CAAAgB,MAAA,CAAAE,cAAA;QACA,KAAAlB,MAAA,CAAAgB,MAAA,CAAAG,eAAA;QACA,KAAAnB,MAAA,CAAAoB,MAAA;QACAC,UAAA;UACA,KAAArB,MAAA,CAAAsB,GAAA,CAAAC,IAAA,CAAAT,OAAA;QACA;MACA;IACA;IACAU,KAAA;MAAA;MACA,KAAAC,KAAA,CAAAC,OAAA,CAAAC,QAAA,CAAAC,KAAA;QACA,IAAAA,KAAA;UACA,KAAAxB,QAAA;YACAyB,GAAA,OAAAzC,IAAA,CAAAqB,EAAA;YACAqB,MAAA,OAAA1C,IAAA,CAAAqB,EAAA;YACApB,IAAA,OAAAD;UACA,GAAAsB,IAAA,CAAAC,GAAA;YACA,IAAAA,GAAA,CAAAoB,IAAA;cAAA;cACA,KAAAC,QAAA,CAAAC,OAAA;cACA;cACA,KAAAvC,WAAA;YACA;cACA,KAAAsC,QAAA,CAAAE,KAAA,CAAAvB,GAAA,CAAAwB,GAAA;YACA;UACA;QACA;MACA;IACA;;IACAC,UAAA;MACA,KAAAhD,IAAA;MACA,KAAAyB,cAAA;MACA,KAAAnB,WAAA;IACA;IACA2C,iBAAA1B,GAAA;MACA,KAAAvB,IAAA,CAAAkD,GAAA,GAAA3B,GAAA,CAAAtB,IAAA;IACA;EACA;EACAkD,QAAA;IACA,KAAAnC,QAAA,CAAAC,GAAA,sBAAAK,IAAA,CAAAC,GAAA;MACA,KAAA6B,OAAA,GAAA7B,GAAA,CAAAtB,IAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}