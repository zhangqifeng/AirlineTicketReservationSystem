<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.BusordersMapper">

    <sql id="Base_Column_List">
        id,name,user_id,time,fly_time,start_airport,end_airport,time_slot,price,num,order_no,status,ticket_id
    </sql>

    <select id="selectAll" resultType="com.example.entity.Busorders">
        select busorders.*, user.name as userName
        from busorders
        left join user on busorders.user_id = user.id
        <where>
            <if test="id != null"> and id= #{id}</if>
            <if test="orderNo != null"> and name like concat('%',  #{name}, '%')</if>
            <if test="userNo != null"> and order_no like concat('%', #{userNo}, '%')</if>
            <if test="userId != null"> and user_id like concat('%', #{userId}, '%')</if>

        </where>
        order by id desc
    </select>

    <select id="selectById" resultType="com.example.entity.Busorders">
        select
        <include refid="Base_Column_List" />
        from busorders
        where id = #{id}
    </select>

    <delete id="deleteById">
        delete from busorders
        where  id = #{id}
    </delete>

    <insert id="insert" parameterType="com.example.entity.Busorders" useGeneratedKeys="true">
        insert into busorders
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="id != null">id,</if>
                <if test="name != null">name,</if>
                <if test="userId != null">user_id,</if>
                <if test="time != null">time,</if>
                <if test="endTime != null">end_time,</if>
                <if test="startAirport != null">start_airport,</if>
                <if test="endAirport != null">end_airport,</if>
                <if test="price != null">price,</if>
                <if test="num != null">num,</if>
                <if test="startCity != null">start_city,</if>
                <if test="endCity != null">end_city,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="id != null">#{id},</if>

                <if test="name != null">#{name},</if>
                <if test="startTime != null">#{startTime},</if>
                <if test="endTime != null">#{endTime},</if>
                <if test="startAirport != null">#{startAirport},</if>
                <if test="endAirport != null">#{endAirport},</if>
                <if test="price != null">#{price},</if>
                <if test="time != null">#{time},</if>
                <if test="num != null">#{num},</if>
                <if test="startCity != null">#{startCity},</if>
                <if test="endCity != null">#{endCity},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.Busorders">
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="userId != null">
                user_id = #{userId},
            </if>
            <if test="time != null">
                time = #{time},
            </if>
            <if test="endTime != null">
                end_time = #{endTime},
            </if>
            <if test="startAirport != null">
                start_airport = #{startAirport},
            </if>
            <if test="endAirport != null">
                end_airport = #{endAirport},
            </if>
            <if test="price != null">
                price = #{price},
            </if>
            <if test="num != null">
            num = #{num},
            </if>
            <if test="startCity != null">
                start_city = #{startCity},
            </if>
            <if test="endCity != null">
                end_city = #{endCity},
            </if>
        </set>
        where id = #{id} 
    </update>

</mapper>